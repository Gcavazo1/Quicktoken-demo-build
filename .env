# Network RPC URLs - Not needed for local testing
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-api-key
# GOERLI_RPC_URL=https://goerli.infura.io/v3/your-api-key
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/your-api-key
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Verification API Keys - Not needed for local testing
# ETHERSCAN_API_KEY=your-etherscan-api-key
# POLYGONSCAN_API_KEY=your-polygonscan-api-key

# Gas reporting
REPORT_GAS=false
# COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# Deployment account - We're using Hardhat default accounts for testing
# PRIVATE_KEY=your-wallet-private-key

# Token Deployment Parameters
TOKEN_NAME=Quick Token
TOKEN_SYMBOL=QUICK
INITIAL_SUPPLY=1000000
MAX_SUPPLY=10000000
MINT_FEE_BPS=200
LOCK_DURATION_SECONDS=604800
PLATFORM_FEE_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8 # Hardhat account #1

# Used by verify.js script
NETWORK=hardhat 